@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using Microsoft.JSInterop
@inject LinkStore Store
@inject IJSRuntime JS

@{
    var summary = GetStatusSummary();
}
<PageTitle>@TabTitle(summary.Down)</PageTitle>

<div class="@DashboardClasses" style="--lm-brightness: @_brightness.ToString(CultureInfo.InvariantCulture)">
    <div class="lm-shell">
        <header class="lm-header">
            <h1 class="lm-title" tabindex="-1">LM Dashboard<span class="lm-cursor" aria-hidden="true">_</span></h1>
            @* Three zero counts say nothing before the first link exists. *@
            @if (_links.Count > 0)
            {
                <p class="lm-summary">
                    <span class="lm-sum @(summary.Up > 0 ? "ok" : "")"><span class="lm-dot ok" aria-hidden="true"></span>@summary.Up up</span>
                    <span class="lm-sum @(summary.Redirect > 0 ? "redirect" : "")"><span class="lm-dot redirect" aria-hidden="true"></span>@summary.Redirect redirect</span>
                    @if (summary.Down > 0)
                    {
                        @* The count is the shortest way to the failing links: it toggles Failing only. *@
                        <button class="lm-sum lm-sum-btn down" aria-pressed="@Pressed(_showFailingOnly)"
                                title="@(_showFailingOnly ? "Show all links" : "Show only failing links")" @onclick="ToggleFailing">
                            <span class="lm-dot down" aria-hidden="true"></span>@summary.Down down
                        </button>
                    }
                    else
                    {
                        <span class="lm-sum"><span class="lm-dot down" aria-hidden="true"></span>0 down</span>
                    }
                    @if (summary.Pending > 0)
                    {
                        <span class="lm-sum"><span class="lm-dot pending" aria-hidden="true"></span>@summary.Pending pending</span>
                    }
                    @if (summary.Paused > 0)
                    {
                        <span class="lm-sum"><span class="lm-dot paused" aria-hidden="true"></span>@summary.Paused paused</span>
                    }
                </p>
            }
            <p class="sr-only" role="status">@_announcement</p>
        </header>

        @* data-search-term tells app.js which search the rendered list reflects, so Enter waits
           for a pending search to land before opening the top match. *@
        <main data-search-term="@_searchTerm">
        <div class="lm-toolbar">
            <label class="sr-only" for="lm-search">Search links</label>
            @* A command prompt: typing filters, Enter opens the top match, Esc clears, / jumps
               here (app.js). Bound on change; app.js raises change once typing pauses so every
               keystroke isn't a round trip. *@
            <span class="lm-prompt">
                <span class="lm-prompt-mark" aria-hidden="true">&gt;</span>
                <input @ref="_searchInput" id="lm-search" type="search" class="lm-input lm-search-input"
                       placeholder="filter · enter to open" aria-describedby="lm-search-hint" aria-keyshortcuts="/"
                       enterkeyhint="go" autocomplete="off" autocapitalize="off" spellcheck="false"
                       @bind="_searchTerm" @bind:after="FilterChanged" />
            </span>
            <span id="lm-search-hint" class="sr-only">Enter opens the first match in a new tab. Escape clears.</span>

            <div class="lm-segmented" role="group" aria-label="Link type">
                <button class="lm-seg @(_filter == LinkFilter.All ? "is-on" : "")" aria-pressed="@Pressed(_filter == LinkFilter.All)" @onclick="() => SetFilter(LinkFilter.All)">All</button>
                <button class="lm-seg @(_filter == LinkFilter.Internal ? "is-on" : "")" aria-pressed="@Pressed(_filter == LinkFilter.Internal)" @onclick="() => SetFilter(LinkFilter.Internal)">Internal</button>
                <button class="lm-seg @(_filter == LinkFilter.External ? "is-on" : "")" aria-pressed="@Pressed(_filter == LinkFilter.External)" @onclick="() => SetFilter(LinkFilter.External)">External</button>
            </div>

            <button class="lm-btn lm-chip" aria-pressed="@Pressed(_grouped && _filter == LinkFilter.All)" disabled="@(_filter != LinkFilter.All)"
                    title="@(_filter == LinkFilter.All ? "Group by type" : "Switch to All to group by type")" @onclick="ToggleGrouped">Group</button>
            <button class="lm-btn lm-chip lm-chip-danger" aria-pressed="@Pressed(_showFailingOnly)" @onclick="ToggleFailing">Failing only</button>

            <span class="lm-toolbar-spacer"></span>
            <button class="lm-btn lm-btn-primary" @onclick="AddNew">Add link</button>
        </div>

        @if (_storeError is not null)
        {
            <div class="lm-alert" role="alert">
                <span>@_storeError</span>
                <button class="lm-btn lm-btn-ghost lm-btn-sm" aria-label="Dismiss" @onclick="() => _storeError = null">Dismiss</button>
            </div>
        }

        @if (_filtered.Count == 0)
        {
            <div class="lm-empty">
                @if (_links.Count == 0)
                {
                    <p class="lm-empty-prompt">&gt; no links yet<span class="lm-cursor" aria-hidden="true">_</span></p>
                    <p>Add the sites and services you want on your start page.</p>
                    <button class="lm-btn lm-btn-primary" @onclick="AddNew">Add link</button>
                }
                else if (_showFailingOnly && string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <p class="lm-empty-prompt">&gt; all systems nominal</p>
                    <p>Nothing is failing right now.</p>
                }
                else if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <p>No links match <span class="lm-empty-term">@_searchTerm</span>.</p>
                    <button class="lm-btn" @onclick="ClearSearch">Clear search</button>
                }
                else
                {
                    <p>No links match the current filters.</p>
                }
            </div>
        }
        else if (_filter == LinkFilter.All && _grouped)
        {
            var internals = _filtered.Where(l => !l.IsExternal).ToList();
            var externals = _filtered.Where(l => l.IsExternal).ToList();

            @if (internals.Count > 0)
            {
                <h2 class="lm-group-title">── Internal · @internals.Count</h2>
                @RenderList(internals, showType: false)
            }
            @if (externals.Count > 0)
            {
                <h2 class="lm-group-title">── External · @externals.Count</h2>
                @RenderList(externals, showType: false)
            }
        }
        else
        {
            @RenderList(_filtered, showType: _filter == LinkFilter.All)
        }

        <LinkDialog Editing="_editing" IsNew="_isNew" Error="@_formError" OnSave="SaveLink" OnCancel="CancelEdit" />
        </main>

        <footer class="lm-footer">
            <span class="lm-mono">v0.1'ish</span>
            <div class="lm-footer-controls">
                @if (_theme == Theme.Classic)
                {
                    <label class="lm-brightness">
                        <span>Brightness</span>
                        @* app.js previews the drag locally; the server only sees the released value. *@
                        <input type="range" class="lm-brightness-slider" min="@MinBrightness.ToString(CultureInfo.InvariantCulture)"
                               max="@MaxBrightness.ToString(CultureInfo.InvariantCulture)" step="0.05"
                               value="@_brightness.ToString(CultureInfo.InvariantCulture)"
                               aria-valuetext="@_brightness.ToString("0.00", CultureInfo.InvariantCulture)" @onchange="OnBrightnessCommitted" />
                        <span class="lm-brightness-value">@_brightness.ToString("0.00", CultureInfo.InvariantCulture)</span>
                    </label>
                    <button class="lm-btn lm-chip lm-btn-sm" aria-pressed="@Pressed(_scanlines)" @onclick="ToggleScanlines">Scanlines</button>
                    <button class="lm-btn lm-chip lm-btn-sm" aria-pressed="@Pressed(_vignette)" @onclick="ToggleVignette">Vignette</button>
                }
                <button class="lm-btn lm-btn-sm" title="Change theme" @onclick="CycleTheme">Theme: @_theme</button>
            </div>
        </footer>
    </div>
</div>

@code {
    // Pings change the store several times a second; UI refreshes are batched to this interval.
    private static readonly TimeSpan RefreshDelay = TimeSpan.FromMilliseconds(250);

    // Matches the slider's min/max; anything the client sends is clamped to this range.
    // The filter dims text but not the black behind it; below 0.85 red "down" text drops
    // under 4.5:1 contrast.
    private const double MinBrightness = 0.85;
    private const double MaxBrightness = 1.5;

    private List<SiteLink> _links = [];
    private List<SiteLink> _filtered = [];
    private SiteLink? _editing;
    private bool _isNew;
    private string? _formError;
    private string? _storeError;
    private LinkFilter _filter = LinkFilter.All;
    private bool _grouped;
    private bool _showFailingOnly;
    private string _searchTerm = string.Empty;
    private Guid? _topMatchId;
    private Guid? _pendingDeleteId;
    private bool _scanlines = true;
    private bool _vignette = true;
    private double _brightness = 1.0;
    private Theme _theme = Theme.Dark;
    private int _refreshQueued;
    private readonly CancellationTokenSource _disposed = new();

    // Whether each link was failing at the last refresh, so going down or coming back can be
    // announced to screen readers. Links seen for the first time are recorded silently.
    private readonly Dictionary<Guid, bool> _wasFailing = [];
    private string _announcement = string.Empty;

    // After a delete, the row that takes the deleted one's place gets focus (null: the heading).
    private bool _restoreFocusAfterDelete;
    private Guid? _focusAfterDelete;

    // Clear search removes its own button, so focus goes back to the search box.
    private ElementReference _searchInput;
    private bool _focusSearch;

    private enum LinkFilter { All, Internal, External }

    private enum Theme { Dark, Light, Classic }

    private string DashboardClasses => string.Join(" ",
        new[]
        {
            "lm-dashboard",
            $"theme-{_theme.ToString().ToLowerInvariant()}",
            _theme == Theme.Classic && _scanlines ? "crt-scanlines" : "",
            _theme == Theme.Classic && _vignette ? "crt-vignette" : ""
        }.Where(c => c.Length > 0));

    private static string Pressed(bool value) => value ? "true" : "false";

    private RenderFragment RenderList(List<SiteLink> links, bool showType) => __builder =>
    {
        <div class="lm-list" role="list">
            @* A report heading for the columns, built from the row's own classes so it lines up in
               every theme. Hidden from screen readers: each row's name already says it all. *@
            <div class="lm-list-head" aria-hidden="true">
                <span class="lm-list-head-cols">
                    <span class="lm-dot-slot"></span>
                    <span class="lm-list-head-name">Name</span>
                    @if (showType)
                    {
                        <span class="lm-badge">Type</span>
                    }
                    <span class="lm-spark">Last 20</span>
                    <span class="lm-row-status">Status</span>
                    <span class="lm-row-latency">Resp</span>
                    <span class="lm-row-interval">Every</span>
                </span>
                @* Invisible stand-ins hold the width of the row buttons. *@
                <span class="lm-row-actions">
                    <span class="lm-btn lm-btn-ghost lm-btn-sm">Pause</span>
                    <span class="lm-btn lm-btn-ghost lm-btn-sm">Edit</span>
                    <span class="lm-btn lm-btn-ghost lm-btn-sm">Delete</span>
                </span>
            </div>
            @foreach (var link in links)
            {
                var id = link.Id;
                <LinkRow @key="id" Link="link" ShowType="showType" TopMatch="_topMatchId == id" ConfirmingDelete="_pendingDeleteId == id"
                         OnToggle="() => TogglePing(id)" OnEdit="() => EditLink(link)"
                         OnRequestDelete="() => RequestDelete(id)" OnConfirmDelete="ConfirmDelete" OnCancelDelete="CancelDelete" />
            }
        </div>
    };

    // A start page lives in a background tab, so the tab title carries the bad news too.
    private static string TabTitle(int down) => down > 0 ? $"({down} down) LM Dashboard" : "LM Dashboard";

    private string? _renderedTitle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var title = TabTitle(GetStatusSummary().Down);
        if (title != _renderedTitle)
        {
            _renderedTitle = title;
            await JS.InvokeVoidAsync("lmSetTitle", title);
        }

        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchInput.FocusAsync();
        }

        if (!_restoreFocusAfterDelete)
            return;

        _restoreFocusAfterDelete = false;
        var selector = _focusAfterDelete is { } id ? $".lm-row-link[data-link-id=\"{id}\"]" : ".lm-title";
        await JS.InvokeVoidAsync("lmFocus.restoreTo", selector, ".lm-title");
    }

    // Rows in the order they appear on screen; grouping puts internal links first.
    private List<SiteLink> DisplayOrder() => _filter == LinkFilter.All && _grouped
        ? [.. _filtered.Where(l => !l.IsExternal), .. _filtered.Where(l => l.IsExternal)]
        : _filtered;

    protected override void OnInitialized()
    {
        Store.OnChange += HandleStoreChange;
        Store.OnPreferencesChange += HandlePreferencesChange;
        ApplyPreferences(Store.LoadPreferences());
        RefreshLinks();
    }

    private void ApplyPreferences(DashboardPreferences prefs)
    {
        _filter = Enum.TryParse<LinkFilter>(prefs.Filter, out var f) ? f : LinkFilter.All;
        _theme = Enum.TryParse<Theme>(prefs.Theme, out var t) && Enum.IsDefined(t) ? t : Theme.Dark;
        _grouped = prefs.Grouped;
        _scanlines = prefs.Scanlines;
        _vignette = prefs.Vignette;
        _showFailingOnly = prefs.ShowFailingOnly;
        _brightness = ClampBrightness(prefs.Brightness);
    }

    private static double ClampBrightness(double value) =>
        double.IsFinite(value) ? Math.Clamp(value, MinBrightness, MaxBrightness) : 1.0;

    private void HandleStoreChange()
    {
        // Only one refresh is queued at a time; changes that land while it waits ride along.
        if (Interlocked.Exchange(ref _refreshQueued, 1) == 1)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(RefreshDelay, _disposed.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            Volatile.Write(ref _refreshQueued, 0);
            RefreshLinks();
            StateHasChanged();
        });
    }

    // Keeps other circuits (browser tabs) in sync when one of them saves preferences.
    private void HandlePreferencesChange()
    {
        InvokeAsync(() =>
        {
            ApplyPreferences(Store.LoadPreferences());
            ApplyFilter();
            StateHasChanged();
        });
    }

    private void RefreshLinks()
    {
        _links = Store.Links.OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase).ToList();
        AnnounceTransitions();
        ApplyFilter();
    }

    private static bool IsFailing(SiteLink l) =>
        l.LastChecked is not null && l.LastStatusCode is not (>= 200 and < 400);

    private void AnnounceTransitions()
    {
        var changes = new List<string>();
        foreach (var link in _links)
        {
            var failing = IsFailing(link);

            // Pausing clears a link's status; that isn't the link recovering.
            if (_wasFailing.TryGetValue(link.Id, out var was) && was != failing && link.PingEnabled)
                changes.Add(failing ? $"{link.Name} is down" : $"{link.Name} is back up");

            _wasFailing[link.Id] = failing;
        }

        if (_wasFailing.Count > _links.Count)
        {
            var current = _links.Select(l => l.Id).ToHashSet();
            foreach (var id in _wasFailing.Keys.Where(id => !current.Contains(id)).ToList())
                _wasFailing.Remove(id);
        }

        if (changes.Count > 0)
            Announce(string.Join(". ", changes) + ".");
    }

    // Live regions only speak when their text changes, so a repeat of the same message gets a
    // trailing no-break space to make it differ.
    private void Announce(string message) =>
        _announcement = message == _announcement ? message + " " : message;

    // A filter the user just changed says how many links it left, since the list itself
    // changes silently.
    private void FilterChanged()
    {
        ApplyFilter();
        var shown = _filtered.Count == 1 ? "1 link shown." : $"{_filtered.Count} links shown.";
        var opens = _topMatchId is { } id ? $" Enter opens {_filtered.First(l => l.Id == id).Name}." : "";
        Announce(shown + opens);
    }

    private void ApplyFilter()
    {
        IEnumerable<SiteLink> result = _filter switch
        {
            LinkFilter.Internal => _links.Where(l => !l.IsExternal),
            LinkFilter.External => _links.Where(l => l.IsExternal),
            _ => _links
        };

        // Failing means a completed check outside 2xx/3xx; redirects count separately
        // in the summary, so they are not treated as failures here either.
        if (_showFailingOnly)
            result = result.Where(IsFailing);

        if (!string.IsNullOrWhiteSpace(_searchTerm))
            result = result.Where(l => l.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                    || l.Url.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

        _filtered = result.ToList();

        // Enter in the prompt opens the first row on screen, so it's marked while a search is typed.
        _topMatchId = string.IsNullOrWhiteSpace(_searchTerm) ? null : DisplayOrder().FirstOrDefault()?.Id;
    }

    private void SetFilter(LinkFilter filter)
    {
        _filter = filter;
        FilterChanged();
        PersistPreferences();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        FilterChanged();
        _focusSearch = true;
    }

    private void ToggleGrouped()
    {
        _grouped = !_grouped;
        ApplyFilter();
        PersistPreferences();
    }

    private void ToggleFailing()
    {
        _showFailingOnly = !_showFailingOnly;
        FilterChanged();
        PersistPreferences();
    }

    private void ToggleScanlines()
    {
        _scanlines = !_scanlines;
        PersistPreferences();
    }

    private void ToggleVignette()
    {
        _vignette = !_vignette;
        PersistPreferences();
    }

    private void CycleTheme()
    {
        _theme = _theme switch
        {
            Theme.Dark => Theme.Light,
            Theme.Light => Theme.Classic,
            _ => Theme.Dark
        };
        PersistPreferences();
    }

    private void OnBrightnessCommitted(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var val)
            && double.IsFinite(val))
        {
            _brightness = ClampBrightness(val);
            PersistPreferences();
        }
    }

    private void AddNew()
    {
        _isNew = true;
        _formError = null;
        _editing = new SiteLink { PingIntervalSeconds = 30 };
    }

    private void EditLink(SiteLink link)
    {
        _isNew = false;
        _formError = null;
        _editing = new SiteLink
        {
            Id = link.Id,
            Name = link.Name,
            Url = link.Url,
            IsExternal = link.IsExternal,
            PingIntervalSeconds = link.PingIntervalSeconds,
            PingEnabled = link.PingEnabled
        };
    }

    private void SaveLink()
    {
        if (_editing is null)
            return;

        _editing.Name = _editing.Name.Trim();
        _editing.Url = _editing.Url.Trim();

        // Each case gets its own message, so fixing one field and saving again announces what's
        // still missing and moves focus there.
        if (_editing.Name.Length == 0 || _editing.Url.Length == 0)
        {
            _formError = (_editing.Name.Length, _editing.Url.Length) switch
            {
                (0, 0) => "Name and URL are required.",
                (0, _) => "Name is required.",
                _ => "URL is required."
            };
            return;
        }

        if (!Uri.TryCreate(_editing.Url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _formError = "Only http:// and https:// URLs are supported.";
            return;
        }

        _editing.PingIntervalSeconds = Math.Max(1, _editing.PingIntervalSeconds);

        var link = _editing;
        var found = true;
        var saved = TryStore(() =>
        {
            if (_isNew)
                Store.Add(link);
            else
                found = Store.Update(link);
        });

        // Show the failure in the dialog, where the user is looking, rather than behind it.
        if (!saved)
        {
            _formError = _storeError;
            _storeError = null;
            return;
        }

        if (!found)
        {
            _formError = "This link no longer exists.";
            return;
        }

        _editing = null;
        _isNew = false;
        _formError = null;
        RefreshLinks();
    }

    private void CancelEdit()
    {
        _editing = null;
        _isNew = false;
        _formError = null;
    }

    private void RequestDelete(Guid id) => _pendingDeleteId = id;

    private void ConfirmDelete()
    {
        if (_pendingDeleteId is not null)
        {
            var id = _pendingDeleteId.Value;
            _pendingDeleteId = null;

            // The next row down takes focus, or the one above when the last row goes.
            var order = DisplayOrder();
            var index = order.FindIndex(l => l.Id == id);
            var neighbour = index < 0 ? null
                : index + 1 < order.Count ? order[index + 1]
                : index > 0 ? order[index - 1]
                : null;

            if (!TryStore(() => Store.Remove(id)))
                return;

            _restoreFocusAfterDelete = true;
            _focusAfterDelete = neighbour?.Id;

            if (_editing is not null && _editing.Id == id)
            {
                _editing = null;
                _isNew = false;
            }
            RefreshLinks();
        }
    }

    private void CancelDelete() => _pendingDeleteId = null;

    private void TogglePing(Guid id)
    {
        if (TryStore(() => Store.TogglePingEnabled(id)))
            RefreshLinks();
    }

    private void PersistPreferences()
    {
        var prefs = new DashboardPreferences
        {
            Filter = _filter.ToString(),
            Theme = _theme.ToString(),
            Grouped = _grouped,
            Scanlines = _scanlines,
            Vignette = _vignette,
            ShowFailingOnly = _showFailingOnly,
            Brightness = _brightness
        };
        TryStore(() => Store.SavePreferences(prefs));
    }

    // A failed write (disk full, file locked by a sync client) leaves the store unchanged;
    // report it here rather than letting the exception end the circuit.
    private bool TryStore(Action write)
    {
        try
        {
            write();
            _storeError = null;
            return true;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _storeError = "Couldn't save your changes. Check the server log.";
            return false;
        }
    }

    private (int Up, int Redirect, int Down, int Pending, int Paused) GetStatusSummary()
    {
        int up = 0, redirect = 0, down = 0, pending = 0, paused = 0;
        foreach (var l in _links)
        {
            if (!l.PingEnabled) paused++;
            else if (l.LastChecked is null) pending++;
            else if (l.LastStatusCode is >= 200 and < 300) up++;
            else if (l.LastStatusCode is >= 300 and < 400) redirect++;
            else down++;
        }
        return (up, redirect, down, pending, paused);
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
        Store.OnPreferencesChange -= HandlePreferencesChange;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
